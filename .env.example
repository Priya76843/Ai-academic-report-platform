# Copy to .env for local development. Names only; never commit real values.
APP_ENV=local
LOG_LEVEL=INFO
API_PREFIX=/api/v1
SECRET_KEY=
DATABASE_URL=postgresql+psycopg://acamedia:acamedia@localhost:5433/acamedia
TEST_DATABASE_URL=postgresql+psycopg://acamedia:acamedia@localhost:5433/acamedia_test
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Object storage: LocalStack S3 locally, AWS S3 or compatible in production
S3_ENDPOINT_URL=http://localhost:4566
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566
S3_REGION=ap-south-1
S3_BUCKET=acamedia-local
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
# Sessions
SESSION_COOKIE_NAME=session_id
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false
# AI
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=fake
EMBEDDING_DIM=1024
USD_INR_RATE=84
